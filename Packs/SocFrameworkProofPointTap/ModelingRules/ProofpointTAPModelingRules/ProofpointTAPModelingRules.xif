[MODEL: dataset=proofpoint_tap_v2_generic_alert_raw]
alter
    tmp_click_ip = clickIP,
    tmp_alert_category = if(classification = "malware", "OTHER", classification),
    tmp_alert_status = if(threatStatus = "active", "IN_REVIEW", null),
    tmp_subject_val = if(subject != null, subject, null),
    tmp_recipient_val = if(recipient != null, recipient, null),
    tmp_cc_addresses_val = if(ccAddresses != null, ccAddresses, null),
    tmp_from_address_val = coalesce(fromAddress, headerFrom)
| alter
    xdm.event.id = id,
    xdm.session_context_id = GUID,
    xdm.event.type = type,
    xdm.source.user_agent = userAgent,
    xdm.source.ipv4 = if(is_ipv4(tmp_click_ip) = true, tmp_click_ip, null),
    xdm.target.url = url,
    xdm.alert.category = tmp_alert_category,
    xdm.alert.original_threat_id = threatID,
    xdm.alert.source_url = threatURL,
    xdm.alert.status = tmp_alert_status,
    xdm.email.recipients = if(tmp_recipient_val != null, arraycreate(tmp_recipient_val), null),
    xdm.email.subject = tmp_subject_val,
    xdm.email.cc = if(tmp_cc_addresses_val != null, arraycreate(tmp_cc_addresses_val), null),
    xdm.email.sender = sender,
    xdm.email.message_id = messageID,
    xdm.email.from_address = tmp_from_address_val
;
