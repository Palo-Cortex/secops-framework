//Generated with AI | UUID: b99ae8b8-e136-48dc-aca2-28e2773c9547 | Timestamp: 2026-09-19T23:54:21.154046Z
[MODEL: dataset=proofpoint_tap_v2_generic_alert_raw]
alter
    // Temporary field for sender IP dual-stack handling
    tmp_sender_ip_field = senderIP,

    // Extracting email recipients from 'recipient' and 'toAddresses' json array strings
    tmp_recipients_from_recipient = json_extract_scalar_array(recipient, "$[*]"),
    tmp_recipients_from_toaddresses = json_extract_scalar_array(toAddresses, "$[*]"),

    // Extracting CC addresses from json array string
    tmp_cc_addresses_array = json_extract_scalar_array(ccAddresses, "$[*]"),

    // Extracting From Address (e.g., MAILER-DAEMON) and From Name (e.g., Mail Delivery Subsystem) from headerFrom field
    tmp_header_from_address = arraystring(regextract(headerFrom, "<([^>]+)>"), ""), // Extracts content within <...>
    tmp_header_from_name = trim(arraystring(regextract(headerFrom, "^([^<]+)"), "")), // Extracts content before <

    // Extracting attachment details (filenames, MD5s, SHA256s) from messageParts json array string
    tmp_attachment_filenames_array = json_extract_scalar_array(messageParts, "$[*].filename"),
    tmp_attachment_md5s_array = json_extract_scalar_array(messageParts, "$[*].md5"),
    tmp_attachment_sha256s_array = json_extract_scalar_array(messageParts, "$[*].sha256"),

    // Extracting threat details (IDs, URLs, Statuses) from threatsInfoMap json array string
    tmp_threat_ids_array = json_extract_scalar_array(threatsInfoMap, "$[*].threatID"),
    tmp_threat_urls_array = json_extract_scalar_array(threatsInfoMap, "$[*].threatUrl"),
    tmp_threat_statuses_array = json_extract_scalar_array(threatsInfoMap, "$[*].threatStatus")
| alter
    // Combine all recipients (from 'recipient' and 'toAddresses') and remove duplicates
    tmp_all_recipients = arraydistinct(arrayconcat(tmp_recipients_from_recipient, tmp_recipients_from_toaddresses)),

    // Get the first threat ID, URL.
    tmp_original_threat_id = arrayindex(tmp_threat_ids_array, 0),
    tmp_source_url = arrayindex(tmp_threat_urls_array, 0),

    // Mapping threatStatus to XDM alert status enum directly
    // Sample: "active" -> XDM: PENDING, IN_REVIEW, DONE
    tmp_alert_status = if(arrayindex(tmp_threat_statuses_array, 0) = "active", "PENDING", null),

    // Mapping classification to XDM alert category enum
    // As "malware" doesn't fit the enum examples, map to null.
    tmp_alert_category = null,

    // Take the first filename, md5, sha256 if available for single attachment fields
    tmp_attachment_filename = arrayindex(tmp_attachment_filenames_array, 0),
    tmp_attachment_md5 = arrayindex(tmp_attachment_md5s_array, 0),
    tmp_attachment_sha256 = arrayindex(tmp_attachment_sha256s_array, 0)
| alter
    // XDM Event fields
    xdm.event.id = id,
    xdm.event.type = type,

    // Map userAgent if it's not null, otherwise omit
    xdm.source.user_agent = userAgent,

    // XDM Source IP dual-stack mapping using tmp_sender_ip_field
    xdm.source.ipv4 = if(is_ipv4(tmp_sender_ip_field), tmp_sender_ip_field, null),
    xdm.source.ipv6 = if(is_ipv6(tmp_sender_ip_field), tmp_sender_ip_field, null),

    // XDM Alert fields - map only if extracted values are not null
    xdm.alert.category = tmp_alert_category,
    xdm.alert.name = null, // No clear field for alert name in the sample
    xdm.alert.original_threat_id = tmp_original_threat_id,
    xdm.alert.source_url = tmp_source_url,
    xdm.alert.status = tmp_alert_status,

    // XDM Email fields
    xdm.email.recipients = tmp_all_recipients,
    xdm.email.attachment.filename = tmp_attachment_filename,
    xdm.email.attachment.md5 = tmp_attachment_md5,
    xdm.email.attachment.sha256 = tmp_attachment_sha256,
    xdm.email.subject = subject,
    xdm.email.cc = tmp_cc_addresses_array,
    xdm.email.sender = coalesce(sender, tmp_header_from_address),
    xdm.email.message_id = messageID,
    xdm.email.from_address = tmp_header_from_address,
    xdm.email.from_name = tmp_header_from_name,
    xdm.session_context_id = GUID,
    xdm.target.url = url,
    xdm.email.delivery_timestamp = messageTime
;
