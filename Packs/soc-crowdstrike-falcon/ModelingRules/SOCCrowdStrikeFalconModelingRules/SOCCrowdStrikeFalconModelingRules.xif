[MODEL: dataset=crowdstrike_falcon_event_raw]
filter product = "epp"
| alter
    tmp_user_name = json_extract_scalar(rawJSON, "$.user_name"),
    tmp_user_principal = json_extract_scalar(rawJSON, "$.user_principal"),
    tmp_user_id = json_extract_scalar(rawJSON, "$.user_id"),
    tmp_src_domain = json_extract_scalar(rawJSON, "$.source_account_domain"),
    tmp_src_sam = json_extract_scalar(rawJSON, "$.source_account_sam_account_name"),
    tmp_src_sid = json_extract_scalar(rawJSON, "$.source_account_object_sid"),
    tmp_tgt_account_name = json_extract_scalar(rawJSON, "$.target_account_name"),
    tmp_device_groups = json_extract_array(rawJSON, "$.device.groups"),
    tmp_device_hostname = json_extract_scalar(rawJSON, "$.device.hostname"),
    tmp_device_os = json_extract_scalar(rawJSON, "$.device.os_version"),
    tmp_device_local_ip = json_extract_scalar(rawJSON, "$.device.local_ip"),
    tmp_host_names = json_extract_array(rawJSON, "$.host_names"),
    tmp_src_ep_hostname = json_extract_scalar(rawJSON, "$.source_endpoint_host_name"),
    tmp_src_ep_ip4 = json_extract_scalar(rawJSON, "$.source_endpoint_address_ip4"),
    tmp_agent_id = json_extract_scalar(rawJSON, "$.agent_id"),
    tmp_tgt_ep_hostname = json_extract_scalar(rawJSON, "$.target_endpoint_host_name"),
    tmp_tgt_ep_sensor = json_extract_scalar(rawJSON, "$.target_endpoint_sensor_id"),
    tmp_dest_hosts = json_extract_array(rawJSON, "$.destination_hosts"),
    tmp_filename = json_extract_scalar(rawJSON, "$.filename"),
    tmp_filepath = json_extract_scalar(rawJSON, "$.filepath"),
    tmp_sha256 = json_extract_scalar(rawJSON, "$.sha256"),
    tmp_md5 = json_extract_scalar(rawJSON, "$.md5"),
    tmp_cmdline = json_extract_scalar(rawJSON, "$.cmdline"),
    tmp_local_pid = json_extract_scalar(rawJSON, "$.local_process_id"),
    tmp_parent_pid = json_extract_scalar(rawJSON, "$.parent_process_id"),
    tmp_severity = json_extract_scalar(rawJSON, "$.severity"),
    tmp_severity_name = json_extract_scalar(rawJSON, "$.severity_name"),
    tmp_name = json_extract_scalar(rawJSON, "$.name"),
    tmp_display_name = json_extract_scalar(rawJSON, "$.display_name"),
    tmp_objective = json_extract_scalar(rawJSON, "$.objective"),
    tmp_description = json_extract_scalar(rawJSON, "$.description"),
    tmp_tactic_id = json_extract_scalar(rawJSON, "$.tactic_id"),
    tmp_technique_id = json_extract_scalar(rawJSON, "$.technique_id"),
    tmp_incident_type = json_extract_scalar(rawJSON, "$.incident_type"),
    tmp_type = json_extract_scalar(rawJSON, "$.type"),
    tmp_id = json_extract_scalar(rawJSON, "$.id"),
    tmp_composite_id = json_extract_scalar(rawJSON, "$.composite_id"),
    tmp_cid = json_extract_scalar(rawJSON, "$.cid")
| alter
    xdm.source.user.username = tmp_user_name,
    xdm.source.user.upn = tmp_user_principal,
    xdm.source.user.domain = tmp_src_domain,
    xdm.source.user.sam_account_name = tmp_src_sam,
    xdm.source.user.identifier = coalesce(tmp_user_id, tmp_src_sid),
    xdm.source.user.groups = tmp_device_groups,
    xdm.target.user.username = tmp_tgt_account_name,
    xdm.source.host.hostname = coalesce(tmp_device_hostname, arrayindex(tmp_host_names, 0), tmp_src_ep_hostname),
    xdm.source.host.device_id = tmp_agent_id,
    xdm.source.agent.identifier = tmp_agent_id,
    xdm.source.host.os = tmp_device_os,
    xdm.source.host.ipv4_addresses = arraycreate(coalesce(tmp_device_local_ip, tmp_src_ep_ip4)),
    xdm.source.ipv4 = coalesce(tmp_device_local_ip, tmp_src_ep_ip4),
    xdm.target.host.hostname = coalesce(tmp_tgt_ep_hostname, arrayindex(tmp_dest_hosts, 0)),
    xdm.target.agent.identifier = tmp_tgt_ep_sensor,
    xdm.source.process.name = tmp_filename,
    xdm.source.process.executable.path = tmp_filepath,
    xdm.source.process.executable.sha256 = tmp_sha256,
    xdm.source.process.executable.md5 = tmp_md5,
    xdm.source.process.command_line = tmp_cmdline,
    xdm.source.process.pid = to_integer(tmp_local_pid),
    xdm.source.process.parent_id = tmp_parent_pid,
    xdm.alert.severity = concat(to_string(tmp_severity), " - ", tmp_severity_name),
    xdm.alert.name = coalesce(tmp_name, tmp_display_name),
    xdm.alert.category = tmp_objective,
    xdm.alert.description = tmp_description,
    xdm.alert.mitre_tactics = arraycreate(tmp_tactic_id),
    xdm.alert.mitre_techniques = arraycreate(tmp_technique_id),
    xdm.event.type = coalesce(tmp_incident_type, tmp_type),
    xdm.event.original_event_type = tmp_incident_type,
    xdm.event.description = tmp_description,
    xdm.event.id = coalesce(tmp_id, tmp_composite_id),
    xdm.observer.vendor = "CrowdStrike",
    xdm.observer.product = "Falcon Insight",
    xdm.observer.unique_identifier = tmp_cid;
filter product = "idp"
| alter
    tmp_src_upn = json_extract_scalar(rawJSON, "$.source_account_upn"),
    tmp_src_account_name = json_extract_scalar(rawJSON, "$.source_account_name"),
    tmp_user_principal = json_extract_scalar(rawJSON, "$.user_principal"),
    tmp_user_name = json_extract_scalar(rawJSON, "$.user_name"),
    tmp_src_domain = json_extract_scalar(rawJSON, "$.source_account_domain"),
    tmp_src_sam = json_extract_scalar(rawJSON, "$.source_account_sam_account_name"),
    tmp_src_sid = json_extract_scalar(rawJSON, "$.source_account_object_sid"),
    tmp_tgt_account_name = json_extract_scalar(rawJSON, "$.target_account_name"),
    tmp_tgt_sid = json_extract_scalar(rawJSON, "$.target_account_object_sid"),
    tmp_src_ep_hostname = json_extract_scalar(rawJSON, "$.source_endpoint_host_name"),
    tmp_src_hosts = json_extract_array(rawJSON, "$.source_hosts"),
    tmp_host_names = json_extract_array(rawJSON, "$.host_names"),
    tmp_src_ep_guid = json_extract_scalar(rawJSON, "$.source_endpoint_account_object_guid"),
    tmp_src_ep_ip4 = json_extract_scalar(rawJSON, "$.source_endpoint_address_ip4"),
    tmp_src_ep_ip6 = json_extract_scalar(rawJSON, "$.source_endpoint_address_ip6"),
    tmp_src_ep_ip = json_extract_scalar(rawJSON, "$.source_endpoint_ip_address"),
    tmp_tgt_ep_hostname = json_extract_scalar(rawJSON, "$.target_endpoint_host_name"),
    tmp_dest_hosts = json_extract_array(rawJSON, "$.destination_hosts"),
    tmp_tgt_ep_sensor = json_extract_scalar(rawJSON, "$.target_endpoint_sensor_id"),
    tmp_country = json_extract_scalar(rawJSON, "$.location_country_code"),
    tmp_asn_org = json_extract_scalar(rawJSON, "$.source_ip_asn_organization"),
    tmp_sso_app_id = json_extract_scalar(rawJSON, "$.sso_application_identifier"),
    tmp_sso_app_uri = json_extract_scalar(rawJSON, "$.sso_application_uri"),
    tmp_severity = json_extract_scalar(rawJSON, "$.severity"),
    tmp_severity_name = json_extract_scalar(rawJSON, "$.severity_name"),
    tmp_name = json_extract_scalar(rawJSON, "$.name"),
    tmp_objective = json_extract_scalar(rawJSON, "$.objective"),
    tmp_description = json_extract_scalar(rawJSON, "$.description"),
    tmp_tactic_id = json_extract_scalar(rawJSON, "$.tactic_id"),
    tmp_technique_id = json_extract_scalar(rawJSON, "$.technique_id"),
    tmp_incident_type = json_extract_scalar(rawJSON, "$.incident_type"),
    tmp_type = json_extract_scalar(rawJSON, "$.type"),
    tmp_id = json_extract_scalar(rawJSON, "$.id"),
    tmp_composite_id = json_extract_scalar(rawJSON, "$.composite_id"),
    tmp_cid = json_extract_scalar(rawJSON, "$.cid")
| alter
    xdm.source.user.username = coalesce(tmp_src_upn, tmp_src_account_name, tmp_user_principal, tmp_user_name),
    xdm.source.user.upn = coalesce(tmp_src_upn, tmp_user_principal),
    xdm.source.user.domain = tmp_src_domain,
    xdm.source.user.sam_account_name = tmp_src_sam,
    xdm.source.user.identifier = tmp_src_sid,
    xdm.target.user.username = tmp_tgt_account_name,
    xdm.target.user.identifier = tmp_tgt_sid,
    xdm.source.host.hostname = coalesce(tmp_src_ep_hostname, arrayindex(tmp_src_hosts, 0), arrayindex(tmp_host_names, 0)),
    xdm.source.host.device_id = tmp_src_ep_guid,
    xdm.source.host.ipv4_addresses = arraycreate(tmp_src_ep_ip4),
    xdm.target.host.hostname = coalesce(tmp_tgt_ep_hostname, arrayindex(tmp_dest_hosts, 0)),
    xdm.target.agent.identifier = tmp_tgt_ep_sensor,
    xdm.source.ipv4 = coalesce(tmp_src_ep_ip4, tmp_src_ep_ip),
    xdm.source.ipv6 = tmp_src_ep_ip6,
    xdm.source.location.country = tmp_country,
    xdm.source.asn.as_name = tmp_asn_org,
    xdm.target.application.name = tmp_sso_app_id,
    xdm.target.url = tmp_sso_app_uri,
    xdm.alert.severity = concat(to_string(tmp_severity), " - ", tmp_severity_name),
    xdm.alert.name = tmp_name,
    xdm.alert.category = tmp_objective,
    xdm.alert.mitre_tactics = arraycreate(tmp_tactic_id),
    xdm.alert.mitre_techniques = arraycreate(tmp_technique_id),
    xdm.event.type = coalesce(tmp_incident_type, tmp_type),
    xdm.event.original_event_type = tmp_incident_type,
    xdm.event.description = tmp_description,
    xdm.event.id = coalesce(tmp_id, tmp_composite_id),
    xdm.observer.vendor = "CrowdStrike",
    xdm.observer.product = "Falcon Identity Protection",
    xdm.observer.unique_identifier = tmp_cid;
filter product = "saas-security"
| alter
    tmp_user_name = json_extract_scalar(rawJSON, "$.user_name"),
    tmp_user_names = json_extract_array(rawJSON, "$.user_names"),
    tmp_country = json_extract_scalar(rawJSON, "$.country"),
    tmp_asn = json_extract_scalar(rawJSON, "$.asn"),
    tmp_asn_name = json_extract_scalar(rawJSON, "$.asn_name"),
    tmp_severity = json_extract_scalar(rawJSON, "$.severity"),
    tmp_severity_name = json_extract_scalar(rawJSON, "$.severity_name"),
    tmp_name = json_extract_scalar(rawJSON, "$.name"),
    tmp_display_name = json_extract_scalar(rawJSON, "$.display_name"),
    tmp_category = json_extract_scalar(rawJSON, "$.category"),
    tmp_objective = json_extract_scalar(rawJSON, "$.objective"),
    tmp_description = json_extract_scalar(rawJSON, "$.description"),
    tmp_event_summary = json_extract_scalar(rawJSON, "$.event_summary"),
    tmp_mitre_tactics = json_extract_array(rawJSON, "$.mitre_attack[*].tactic_id"),
    tmp_mitre_techniques = json_extract_array(rawJSON, "$.mitre_attack[*].technique_id"),
    tmp_incident_type = json_extract_scalar(rawJSON, "$.incident_type"),
    tmp_type = json_extract_scalar(rawJSON, "$.type"),
    tmp_id = json_extract_scalar(rawJSON, "$.id"),
    tmp_composite_id = json_extract_scalar(rawJSON, "$.composite_id"),
    tmp_cid = json_extract_scalar(rawJSON, "$.cid")
| alter
    xdm.source.user.username = coalesce(tmp_user_name, arrayindex(tmp_user_names, 0)),
    xdm.source.user.upn = tmp_user_name,
    xdm.source.location.country = tmp_country,
    xdm.source.asn.as_number = to_integer(tmp_asn),
    xdm.source.asn.as_name = tmp_asn_name,
    xdm.alert.severity = concat(to_string(tmp_severity), " - ", tmp_severity_name),
    xdm.alert.name = coalesce(tmp_name, tmp_display_name),
    xdm.alert.category = coalesce(tmp_category, tmp_objective),
    xdm.alert.description = coalesce(tmp_description, tmp_event_summary),
    xdm.alert.mitre_tactics = tmp_mitre_tactics,
    xdm.alert.mitre_techniques = tmp_mitre_techniques,
    xdm.event.type = coalesce(tmp_incident_type, tmp_type),
    xdm.event.original_event_type = tmp_type,
    xdm.event.description = coalesce(tmp_description, tmp_event_summary),
    xdm.event.id = coalesce(tmp_id, tmp_composite_id),
    xdm.observer.vendor = "CrowdStrike",
    xdm.observer.product = "Falcon SaaS Security",
    xdm.observer.unique_identifier = tmp_cid;
