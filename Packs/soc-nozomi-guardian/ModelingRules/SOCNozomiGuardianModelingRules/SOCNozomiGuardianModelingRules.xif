[MODEL: dataset=nozomi_networks_generic_alert_raw]
alter
xdm.event.id = to_string(id),
xdm.event.type = type_name,
xdm.alert.original_alert_id = to_string(id),
xdm.alert.name = name,
xdm.alert.description = description,
xdm.alert.severity = to_string(risk),
xdm.alert.category = type_name,
xdm.alert.subcategory = threat_name,
xdm.source.ipv4 = ip_src,
xdm.target.ipv4 = ip_dst,
xdm.target.port = to_integer(port_dst);
