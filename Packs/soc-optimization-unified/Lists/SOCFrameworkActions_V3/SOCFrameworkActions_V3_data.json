{
  "id": "SOCFrameworkActions_V3",
  "name": "SOCFrameworkActions_V3",
  "soc-close-issue": {
    "responses": {
      "Builtin": {
        "command": "closeInvestigation",
        "inline_args": {
          "id": "${incident.id}",
          "closeReason": "${Assessment.closure_reason}",
          "closeNotes": "Closed by SOC Framework assessment: ${Assessment.verdict}, ${Assessment.closure_confidence} closure confidence. ${Assessment.closure_reason}"
        }
      }
    },
    "shadow_mode": true,
    "phase": "triage",
    "entity_scope": "case",
    "capability": "Triage \u2014 close issue"
  },
  "soc-isolate-endpoint": {
    "responses": {
      "Cortex Core - IR": {
        "command": "core-isolate-endpoint",
        "inline_args": {
          "endpoint_id": "${SOCFramework.Artifacts.EndPointID}"
        }
      },
      "Trend Micro Vision One V3": {
        "command": "trendmicro-visionone-isolate-endpoint",
        "inline_args": {
          "endpoint_identifiers": "${SOCFramework.Artifacts.EndPointID}"
        }
      },
      "Microsoft Defender Advanced Threat Protection": {
        "command": "microsoft-atp-isolate-machine",
        "inline_args": {
          "machine_id": "${SOCFramework.Artifacts.EndPointID}",
          "comment": "SOCFramework isolate endpoint",
          "isolation_type": "Full"
        }
      },
      "CrowdStrike Falcon": {
        "command": "cs-falcon-contain-host",
        "inline_args": {
          "agent_id": "${SOCFramework.Artifacts.EndPointID}"
        }
      },
      "SentinelOne V2": {
        "command": "sentinelone-disconnect-agent",
        "inline_args": {
          "agent_id": "${SOCFramework.Artifacts.EndPointID}"
        }
      }
    },
    "shadow_mode": true,
    "phase": "containment",
    "entity_scope": "host",
    "sequence_rank": 40,
    "reversed_by": "soc-deisolate-endpoint",
    "auto_reverse": true,
    "capability": "Endpoint containment \u2014 isolate host"
  },
  "soc-deisolate-endpoint": {
    "responses": {
      "Cortex Core - IR": {
        "command": "core-unisolate-endpoint",
        "inline_args": {
          "endpoint_id": "${SOCFramework.Artifacts.EndPointID}"
        }
      },
      "Microsoft Defender Advanced Threat Protection": {
        "command": "microsoft-atp-unisolate-machine",
        "inline_args": {
          "machine_id": "${SOCFramework.Artifacts.EndPointID}"
        }
      },
      "CrowdStrike Falcon": {
        "command": "cs-falcon-lift-host-containment",
        "inline_args": {
          "agent_id": "${SOCFramework.Artifacts.EndPointID}"
        }
      },
      "SentinelOne V2": {
        "command": "sentinelone-connect-agent",
        "inline_args": {
          "agent_id": "${SOCFramework.Artifacts.EndPointID}"
        }
      }
    },
    "shadow_mode": true,
    "phase": "recovery",
    "entity_scope": "host",
    "capability": "Endpoint recovery \u2014 restore host connectivity"
  },
  "soc-kill-process": {
    "responses": {
      "Cortex Core - IR": {
        "command": "core-run-script-kill-process",
        "inline_args": {
          "endpoint_ids": "${SOCFramework.Artifacts.EndPointID}",
          "process_names": "${SOCFramework.Artifacts.Process.Name}"
        }
      },
      "Trend Micro Vision One V3": {
        "command": "trendmicro-visionone-terminate-process",
        "inline_args": {
          "process_identifiers": "${SOCFramework.Artifacts.Process.PID}"
        }
      },
      "CrowdStrike Falcon": {
        "command": "cs-falcon-run-command",
        "inline_args": {
          "host_ids": "${SOCFramework.Artifacts.EndPointID}",
          "command_type": "runscript",
          "full_command": "runscript -Raw=```Stop-Process -Id ${SOCFramework.Artifacts.Process.PID} -Force -ErrorAction SilentlyContinue```"
        }
      },
      "Microsoft Defender Advanced Threat Protection": {
        "command": "microsoft-atp-live-response-run-script",
        "inline_args": {
          "machine_id": "${SOCFramework.Artifacts.EndPointID}",
          "script_name": "StopProcess.ps1",
          "args": "${SOCFramework.Artifacts.Process.PID}"
        }
      }
    },
    "shadow_mode": true,
    "phase": "containment",
    "entity_scope": "host",
    "sequence_rank": 10,
    "destroys_evidence": true,
    "capability": "Endpoint containment \u2014 halt process"
  },
  "soc-remove-file": {
    "responses": {
      "Cortex Core - IR": {
        "command": "core-run-script-delete-file",
        "inline_args": {
          "endpoint_id": "${SOCFramework.Artifacts.EndPointID}",
          "file_path": "${SOCFramework.Artifacts.FilePath}"
        }
      },
      "Microsoft Defender Advanced Threat Protection": {
        "command": "microsoft-atp-stop-and-quarantine-file",
        "inline_args": {
          "machine_ids": "${SOCFramework.Artifacts.EndPointID}",
          "file_hashes": "${SOCFramework.Artifacts.File}"
        }
      },
      "CrowdStrike Falcon": {
        "command": "cs-falcon-run-command",
        "inline_args": {
          "host_ids": "${SOCFramework.Artifacts.EndPointID}",
          "command_type": "runscript",
          "full_command": "runscript -Raw=```Remove-Item -Path '${SOCFramework.Artifacts.FilePath}' -Force -ErrorAction SilentlyContinue```"
        }
      }
    },
    "shadow_mode": true,
    "phase": "eradication",
    "entity_scope": "host",
    "destroys_evidence": true,
    "capability": "Endpoint eradication \u2014 remove file"
  },
  "soc-remove-persistence": {
    "responses": {
      "Cortex Core - IR": {
        "command": "core-script-run",
        "inline_args": {
          "endpoint_ids": "${SOCFramework.Artifacts.EndPointID}",
          "script_name": "remove_persistence",
          "parameters": "${SOCFramework.Artifacts.FilePath}"
        }
      },
      "CrowdStrike Falcon": {
        "command": "cs-falcon-run-command",
        "inline_args": {
          "host_ids": "${SOCFramework.Artifacts.EndPointID}",
          "command_type": "runscript",
          "full_command": "runscript -Raw=```Remove-ItemProperty -Path 'HKLM:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name '${SOCFramework.Artifacts.Process.Name}' -ErrorAction SilentlyContinue; Unregister-ScheduledTask -TaskName '${SOCFramework.Artifacts.Process.Name}' -Confirm:$false -ErrorAction SilentlyContinue```"
        }
      },
      "Microsoft Defender Advanced Threat Protection": {
        "command": "microsoft-atp-stop-and-quarantine-file",
        "inline_args": {
          "machine_ids": "${SOCFramework.Artifacts.EndPointID}",
          "file_hashes": "${SOCFramework.Artifacts.File}"
        }
      }
    },
    "shadow_mode": true,
    "phase": "eradication",
    "entity_scope": "host",
    "capability": "Endpoint eradication \u2014 remove persistence"
  },
  "soc-delete-file": {
    "responses": {
      "Cortex Core - IR": {
        "command": "core-run-script-delete-file",
        "inline_args": {
          "endpoint_id": "${SOCFramework.Artifacts.EndPointID}",
          "file_path": "${SOCFramework.Artifacts.FilePath}"
        }
      },
      "CrowdStrike Falcon": {
        "command": "cs-falcon-run-command",
        "inline_args": {
          "host_ids": "${SOCFramework.Artifacts.EndPointID}",
          "command_type": "runscript",
          "full_command": "runscript -Raw=```Remove-Item -Path '${SOCFramework.Artifacts.FilePath}' -Force -ErrorAction SilentlyContinue```"
        }
      }
    },
    "shadow_mode": true,
    "phase": "eradication",
    "entity_scope": "host",
    "destroys_evidence": true,
    "capability": "Endpoint eradication \u2014 delete file"
  },
  "soc-file-exists": {
    "responses": {
      "Cortex Core - IR": {
        "command": "core-run-script-file-exists",
        "inline_args": {
          "endpoint_id": "${SOCFramework.Artifacts.EndPointID}",
          "file_path": "${SOCFramework.Artifacts.FilePath}"
        }
      },
      "CrowdStrike Falcon": {
        "command": "cs-falcon-run-command",
        "inline_args": {
          "host_ids": "${SOCFramework.Artifacts.EndPointID}",
          "command_type": "runscript",
          "full_command": "runscript -Raw=```Test-Path -Path '${SOCFramework.Artifacts.FilePath}'```"
        }
      },
      "Microsoft Defender Advanced Threat Protection": {
        "command": "microsoft-atp-live-response-get-file",
        "inline_args": {
          "machine_id": "${SOCFramework.Artifacts.EndPointID}",
          "path": "${SOCFramework.Artifacts.FilePath}"
        }
      }
    },
    "shadow_mode": false,
    "phase": "investigation",
    "entity_scope": "host",
    "capability": "Endpoint investigation \u2014 confirm file present"
  },
  "soc-quarantine-files": {
    "responses": {
      "Cortex Core - IR": {
        "command": "core-quarantine-files",
        "inline_args": {
          "endpoint_id_list": "${SOCFramework.Artifacts.EndPointID}",
          "file_hash": "${SOCFramework.Artifacts.File}",
          "file_path": "${SOCFramework.Artifacts.FilePath}"
        }
      },
      "Microsoft Defender Advanced Threat Protection": {
        "command": "microsoft-atp-stop-and-quarantine-file",
        "inline_args": {
          "machine_ids": "${SOCFramework.Artifacts.EndPointID}",
          "file_hashes": "${SOCFramework.Artifacts.File}"
        }
      }
    },
    "shadow_mode": true,
    "phase": "containment",
    "entity_scope": "artifact",
    "sequence_rank": 50,
    "capability": "Endpoint containment \u2014 quarantine file"
  },
  "soc-disable-user": {
    "responses": {
      "Active Directory Query v2": {
        "command": "disable-user",
        "inline_args": {
          "user_email": "${SOCFramework.Artifacts.Identity.User.Email}",
          "user_name": "${SOCFramework.Artifacts.Identity.User.Name}",
          "user_id": "${SOCFramework.Artifacts.Identity.User.ID}"
        }
      },
      "Microsoft Graph User": {
        "command": "disable-user",
        "inline_args": {
          "user_email": "${SOCFramework.Artifacts.Identity.User.Email}",
          "user_name": "${SOCFramework.Artifacts.Identity.User.Name}",
          "user_id": "${SOCFramework.Artifacts.Identity.User.ID}"
        }
      },
      "Okta IAM": {
        "command": "disable-user",
        "inline_args": {
          "user_email": "${SOCFramework.Artifacts.Identity.User.Email}",
          "user_name": "${SOCFramework.Artifacts.Identity.User.Name}",
          "user_id": "${SOCFramework.Artifacts.Identity.User.ID}"
        }
      },
      "Okta v2": {
        "command": "okta-deactivate-user",
        "inline_args": {
          "username": "${SOCFramework.Artifacts.Identity.User.UPN}"
        }
      }
    },
    "shadow_mode": true,
    "phase": "containment",
    "entity_scope": "identity",
    "sequence_rank": 30,
    "reversed_by": "soc-enable-user",
    "auto_reverse": true,
    "capability": "Identity containment \u2014 disable account"
  },
  "soc-clear-sessions": {
    "responses": {
      "Okta v2": {
        "command": "okta-clear-user-sessions",
        "inline_args": {
          "userId": "${SOCFramework.Artifacts.Identity.User.ID}"
        }
      }
    },
    "shadow_mode": true,
    "phase": "containment",
    "entity_scope": "identity",
    "sequence_rank": 10,
    "capability": "Identity containment \u2014 clear active sessions"
  },
  "soc-reset-password": {
    "responses": {
      "Active Directory Query v2": {
        "command": "ad-set-new-password",
        "inline_args": {
          "sAMAccountName": "${SOCFramework.Artifacts.Identity.User.Name}",
          "password": "auto-generated"
        }
      },
      "Okta v2": {
        "command": "okta-expire-password",
        "inline_args": {
          "username": "${SOCFramework.Artifacts.Identity.User.UPN}",
          "temporary_password": "true",
          "revoke_session": "true"
        }
      }
    },
    "shadow_mode": true,
    "phase": "eradication",
    "entity_scope": "identity",
    "capability": "Identity eradication \u2014 reset credential"
  },
  "soc-revoke-tokens": {
    "responses": {
      "Okta v2": {
        "command": "okta-clear-user-sessions",
        "inline_args": {
          "userId": "${SOCFramework.Artifacts.Identity.User.ID}",
          "revokeOauthTokens": "true"
        }
      },
      "Entra ID Users": {
        "command": "msgraph-user-account-disable",
        "inline_args": {
          "user": "${SOCFramework.Artifacts.Identity.User.Name}"
        }
      }
    },
    "shadow_mode": true,
    "phase": "containment",
    "entity_scope": "identity",
    "sequence_rank": 10,
    "capability": "Identity containment \u2014 revoke tokens"
  },
  "soc-enable-user": {
    "responses": {
      "Active Directory Query v2": {
        "command": "ad-enable-account",
        "inline_args": {
          "sAMAccountName": "${SOCFramework.Artifacts.Identity.User.Name}"
        }
      },
      "Okta v2": {
        "command": "okta-activate-user",
        "inline_args": {
          "username": "${SOCFramework.Artifacts.Identity.User.UPN}"
        }
      }
    },
    "shadow_mode": true,
    "phase": "recovery",
    "entity_scope": "identity",
    "capability": "Identity recovery \u2014 re-enable account"
  },
  "soc-enrich-user": {
    "responses": {
      "Active Directory Query v2": {
        "command": "ad-get-user",
        "inline_args": {
          "username": "${SOCFramework.Artifacts.Identity.User.SAM}"
        }
      },
      "Microsoft Graph User": {
        "command": "msgraph-user-get",
        "inline_args": {
          "user": "${SOCFramework.Artifacts.Identity.User.UPN}",
          "properties": "displayName,userPrincipalName,mail,jobTitle,department,city,officeLocation,employeeId,accountEnabled,onPremisesExtensionAttributes,onPremisesSamAccountName,country,companyName,mobilePhone,employeeType"
        }
      },
      "Okta v2": {
        "command": "okta-get-user",
        "inline_args": {
          "username": "${SOCFramework.Artifacts.Identity.User.UPN}"
        }
      },
      "Okta IAM": {
        "command": "iam-get-user",
        "inline_args": {
          "user_profile": "${SOCFramework.Artifacts.Identity.User.UPN}"
        }
      },
      "Google Workspace": {
        "command": "gsuite-user-get",
        "inline_args": {
          "user-key": "${SOCFramework.Artifacts.Identity.User.Email}"
        }
      },
      "AWS - IAM": {
        "command": "aws-iam-get-user",
        "inline_args": {
          "userName": "${SOCFramework.Artifacts.Identity.User.Name}"
        }
      },
      "PingOne": {
        "command": "pingone-get-user",
        "inline_args": {
          "userId": "${SOCFramework.Artifacts.Identity.User.UPN}"
        }
      }
    },
    "shadow_mode": false,
    "phase": "enrichment",
    "entity_scope": "identity",
    "capability": "Enrichment \u2014 user"
  },
  "soc-enrich-endpoint": {
    "responses": {
      "Cortex Core - IR": {
        "command": "core-get-endpoints",
        "inline_args": {
          "endpoint_id_list": "${SOCFramework.Artifacts.Endpoint.AgentID}"
        }
      },
      "Carbon Black EDR": {
        "command": "cb-edr-sensors-list",
        "inline_args": {
          "hostname": "${SOCFramework.Artifacts.Endpoint.Hostname}"
        }
      },
      "Armis": {
        "command": "armis-search-devices",
        "inline_args": {
          "name": "${SOCFramework.Artifacts.Endpoint.Hostname}"
        }
      },
      "ExtraHop": {
        "command": "extrahop-devices-search",
        "inline_args": {
          "name": "${SOCFramework.Artifacts.Endpoint.Hostname}"
        }
      },
      "CrowdStrike Falcon": {
        "command": "cs-falcon-search-device",
        "inline_args": {
          "hostname": "${SOCFramework.Artifacts.Endpoint.Hostname}"
        }
      },
      "Microsoft Defender Advanced Threat Protection": {
        "command": "microsoft-atp-get-machine-details",
        "inline_args": {
          "machine_id": "${SOCFramework.Artifacts.Endpoint.AgentID}"
        }
      },
      "SentinelOne V2": {
        "command": "sentinelone-list-agents",
        "inline_args": {
          "computer_name": "${SOCFramework.Artifacts.Endpoint.Hostname}"
        }
      },
      "Trend Micro Vision One": {
        "command": "trendmicro-visionone-get-endpoint-info",
        "inline_args": {
          "endpoint": "${SOCFramework.Artifacts.Endpoint.Hostname}",
          "query_op": "or"
        }
      }
    },
    "shadow_mode": false,
    "phase": "enrichment",
    "entity_scope": "host",
    "capability": "Enrichment \u2014 endpoint"
  },
  "soc-enrich-file": {
    "responses": {
      "Cortex Core - IR": {
        "command": "core-get-hash-analytics-prevalence",
        "inline_args": {
          "sha256": "${SOCFramework.Artifacts.Hash}"
        },
        "output_map": {
          "UC.Enrich.File.hash_prevalence_count": "Core.AnalyticsPrevalence.Hash.data.global_prevalence.value",
          "UC.Enrich.File.prevalence": "Core.AnalyticsPrevalence.Hash.prevalence",
          "UC.Enrich.File.verdict": "Core.AnalyticsPrevalence.Hash.data.description"
        }
      },
      "WildFire": {
        "command": "wildfire-get-verdict",
        "inline_args": {
          "hash": "${SOCFramework.Artifacts.Hash}"
        },
        "output_map": {
          "UC.Enrich.File.verdict": "WildFire.Report.verdict",
          "UC.Enrich.File.malicious": "WildFire.Report.malware_family"
        }
      },
      "VirusTotal (Private API)": {
        "command": "vt-private-get-file-report",
        "inline_args": {
          "resource": "${SOCFramework.Artifacts.Hash}"
        },
        "output_map": {
          "UC.Enrich.File.verdict": "VirusTotal.File.Verdict",
          "UC.Enrich.File.hash_prevalence_count": "VirusTotal.File.DetectionEngines"
        }
      },
      "SentinelOne V2": {
        "command": "sentinelone-get-hash",
        "inline_args": {
          "hash": "${SOCFramework.Artifacts.Hash}"
        },
        "output_map": {
          "UC.Enrich.File.verdict": "SentinelOne.Hash.Verdict"
        }
      }
    },
    "shadow_mode": false,
    "phase": "enrichment",
    "entity_scope": "artifact",
    "capability": "Enrichment \u2014 file"
  },
  "soc-enrich-ip": {
    "responses": {
      "Cortex Core - IR": {
        "command": "core-get-IP-analytics-prevalence",
        "inline_args": {
          "ip_address": "${SOCFramework.Artifacts.Network.IP}"
        },
        "output_map": {
          "UC.Enrich.IP.prevalence": "Core.AnalyticsPrevalence.IP.prevalence",
          "UC.Enrich.IP.count": "Core.AnalyticsPrevalence.IP.data.global_prevalence.value"
        }
      },
      "VirusTotal (Private API)": {
        "command": "vt-private-get-ip-report",
        "inline_args": {
          "ip": "${SOCFramework.Artifacts.Network.IP}"
        },
        "output_map": {
          "UC.Enrich.IP.verdict": "VirusTotal.IP.Verdict",
          "UC.Enrich.IP.detections": "VirusTotal.IP.DetectionEngines"
        }
      },
      "Recorded Future": {
        "command": "recordedfuture-intelligence",
        "inline_args": {
          "entity": "${SOCFramework.Artifacts.Network.IP}",
          "entity_type": "ip"
        },
        "output_map": {
          "UC.Enrich.IP.risk_score": "RecordedFuture.IP.riskScore",
          "UC.Enrich.IP.verdict": "RecordedFuture.IP.riskString"
        }
      }
    },
    "shadow_mode": false,
    "phase": "enrichment",
    "entity_scope": "artifact",
    "capability": "Enrichment \u2014 ip"
  },
  "soc-enrich-domain": {
    "responses": {
      "Cortex Core - IR": {
        "command": "core-get-domain-analytics-prevalence",
