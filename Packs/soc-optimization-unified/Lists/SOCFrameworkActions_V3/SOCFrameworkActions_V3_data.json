          "UC.Email.Forensics.file": "Proofpoint.Report.File",
          "UC.Email.Forensics.attachment": "Proofpoint.Report.Attachment"
        }
      },
      "Abnormal Security": {
        "command": "abnormal-security-get-threat",
        "inline_args": {
          "threat_id": "${SOCFramework.Email.threat_id}"
        },
        "output_map": {
          "UC.Email.Forensics.messages": "AbnormalSecurity.ThreatDetails.messages",
