[MODEL: dataset=spycloudenterpriseprotectionfeed_generic_alert_raw]
alter
xdm.event.id = to_string(document_id),
xdm.event.type = breach_category,
xdm.alert.original_alert_id = to_string(document_id),
xdm.alert.name = breach_title,
xdm.alert.severity = to_string(severity),
xdm.alert.category = breach_category;
